DATABASE_URI=sqlite:///agrocontrol.db
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ACCESS_EXPIRES=3600
JWT_REFRESH_EXPIRES=604800
AUTH_ENABLED=true

MODEL_PATH=backend/ml/artifacts/distilled_student.onnx
MODEL_METADATA_PATH=backend/ml/artifacts/model_metadata.json
CLASSES_PATH=backend/ml/artifacts/classes.txt

OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_HOST=http://127.0.0.1:11437
OLLAMA_TIMEOUT=8
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=180
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_GPU=999

MQTT_ENABLED=true
MQTT_EMULATION=true
MQTT_BROKER_URL=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DEVICE_ID=
MQTT_QOS=1
MQTT_STALE_SECONDS=120
