<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="86dp"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivCommandIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_history_icon"
            android:contentDescription="Тип действия"
            android:padding="8dp"
            android:src="@drawable/ic_history_system"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorPrimary"
            tools:ignore="HardcodedSrc" />

        <ImageView
            android:id="@+id/selectionIndicator"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_selection_check"
            android:contentDescription="Запись выбрана"
            android:padding="9dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/ivCommandIcon"
            app:layout_constraintTop_toTopOf="@id/ivCommandIcon"
            app:tint="@android:color/white"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvCommandDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:maxLines="2"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvStatus"
            app:layout_constraintStart_toEndOf="@id/ivCommandIcon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Изменены состояния оборудования" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Выполнена" />

        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivCommandIcon"
            app:layout_constraintTop_toBottomOf="@id/tvCommandDescription"
            tools:text="Сегодня, 15:42" />

        <TextView
            android:id="@+id/tvResponseSnippet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivCommandIcon"
            app:layout_constraintTop_toBottomOf="@id/tvTimestamp"
            tools:text="Отправлены выбранные состояния оборудования." />

        <TextView
            android:id="@+id/tvDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_history_details"
            android:padding="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivCommandIcon"
            app:layout_constraintTop_toBottomOf="@id/tvResponseSnippet"
            tools:text="Состояние устройств:\n• Реле 1: включено\n• Реле 2: выключено"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvExpandHint"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:text="Подробнее"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivCommandIcon"
            app:layout_constraintTop_toBottomOf="@id/tvDetails" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
